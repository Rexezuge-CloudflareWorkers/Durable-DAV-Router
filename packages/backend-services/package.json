{
  "name": "@durable-dav-router/backend-services",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/*": "./src/auth/*.ts",
    "./identity": "./src/identity/index.ts",
    "./identity/*": "./src/identity/*.ts",
    "./user": "./src/user/index.ts",
    "./user/*": "./src/user/*.ts",
    "./composition": "./src/composition/index.ts",
    "./composition/*": "./src/composition/*.ts",
    "./errors": "./src/errors/index.ts",
    "./errors/*": "./src/errors/*.ts",
    "./router": "./src/router/index.ts",
    "./router/*": "./src/router/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@durable-dav-router/backend-data": "workspace:*",
    "@durable-dav-router/backend-errors": "workspace:*",
    "@durable-dav-router/backend-runtime": "workspace:*",
    "@durable-dav-router/shared": "workspace:*",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "6.0.3"
  }
}
