  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@durable-dav-router/backend-data": "workspace:*",
    "@durable-dav-router/backend-runtime": "workspace:*",
    "@durable-dav-router/shared": "workspace:*",
    "@rexezuge/d1": "^1.2.0",
    "@rexezuge/errors": "^1.9.0",
    "@rexezuge/http": "^1.9.0",
    "@rexezuge/i18n": "^1.2.0",
    "@rexezuge/identity": "^1.2.0",
    "@rexezuge/runtime": "^1.9.0",
    "@rexezuge/shared": "^1.9.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  }
