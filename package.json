{
  "name": "@durable-dav-router/monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-spa-shell-stub.mjs && pnpm run typegen",
    "build": "pnpm -r build",
    "checks": "pnpm -r typecheck && pnpm run lint && node scripts/check-god-files.mjs && pnpm run validate:locales && node scripts/verify-spa-shell.mjs",
    "checks:all": "pnpm run checks && pnpm run test:coverage",
    "prettier": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && vitest run --config vitest.web.config.mts",
    "test:coverage": "vitest run --coverage && vitest run --config vitest.web.config.mts --coverage",
    "test:integration": "vitest run --config test/integration/vitest.config.mts",
    "test:coverage:integration": "vitest run --coverage --config test/integration/vitest.config.mts",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint --fix --quiet .",
    "validate:locales": "node scripts/validate_locales.ts",
    "change-email": "tsx scripts/change-email.ts",
    "typegen": "wrangler types --config ./apps/api/wrangler.template.jsonc --env-interface CloudflareEnv"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "zod": "4.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.12.0",
    "i18next": "^26.4.2",
    "jsdom": "30.1.2",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "7.18.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  },
  "packageManager": "pnpm@11.2.2",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "type": "module"
}
