{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "durable-dav-router",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2025-11-29",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": false,
  "minify": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "routes": [],
  "placement": {
    "mode": "off"
  },
  "assets": {
    "directory": "./apps/web/dist/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "durable-dav-router-db"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "DEBUG_MODE": "false",
    "SITE_URL": "",
    "POLICY_AUD": "",
    "TEAM_DOMAIN": "",
    "MAX_BACKENDS_PER_USER": "20",
    "BACKEND_FETCH_TIMEOUT_MS": "8000",
    "ROUTE_CACHE_TTL_SECONDS": "86400",
    "DEV_AUTH_EMAIL": "test@example.com"
  }
}
