{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "durable-dav-router",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2025-11-29",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": false,
  "minify": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "routes": [],
  "placement": {
    "mode": "off"
  },
  "assets": {
    "directory": "./apps/web/dist/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "durable-dav-router-db"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000000000000000000000000000"
    }
  ],
  // No DEV_AUTH_EMAIL / DEMO_MODE here on purpose. Those are authentication
  // bypasses: with either set, every unauthenticated request authenticates as
  // that identity. `isBypassAllowed()` only honors them for ENVIRONMENT in
  // {development, dev, local, test}, but shipping a ready-made bypass identity
  // inside the production template makes a one-word edit (`ENVIRONMENT:
  // "staging"`, or an `env.staging` block that inherits `vars`) a full account
  // takeover with no attacker effort. Set them only in a non-production
  // environment block, and prefer a secret over a plaintext var.
  "vars": {
    "ENVIRONMENT": "production",
    "DEBUG_MODE": "false",
    "SITE_URL": "",
    "POLICY_AUD": "",
    "TEAM_DOMAIN": "",
    "MAX_BACKENDS_PER_USER": "20",
    "BACKEND_FETCH_TIMEOUT_MS": "8000",
    "ROUTE_CACHE_TTL_SECONDS": "86400"
  }
}
